# Скопируйте в deploy/.env и заполните.
# Ключи LiveKit: любые случайные строки, например
#   openssl rand -hex 8   → LK_API_KEY
#   openssl rand -hex 32  → LK_API_SECRET
LK_API_KEY=
LK_API_SECRET=
# Публичный IPv4 сервера (сейчас halomvp.ru → 194.61.9.72)
PUBLIC_IP=194.61.9.72

# Хранилище фото в чате (Timeweb S3)
S3_ACCESS_KEY=
S3_SECRET_KEY=
