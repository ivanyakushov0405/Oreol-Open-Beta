# Copy to deploy/.env and fill in.
# LiveKit keys: any random strings, e.g.
#   openssl rand -hex 8   → LK_API_KEY
#   openssl rand -hex 32  → LK_API_SECRET
LK_API_KEY=
LK_API_SECRET=
# Server public IPv4 (currently halomvp.ru -> 194.61.9.72)
PUBLIC_IP=194.61.9.72

# Chat media storage (Timeweb S3)
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Token for admin endpoints (chat cleanup: DELETE /clear_chat/<room> with Authorization: Bearer <token>).
# Empty disables them. Generate with: openssl rand -hex 32
ADMIN_TOKEN=
