# Required for Docker Compose. Generate both values as described in the README.
LK_API_KEY=
LK_API_SECRET=

# For internet access set the Nginx WSS address and the VPS public IPv4.
# Example: LK_SERVER_URL=wss://rtc.example.com
# Example: LIVEKIT_NODE_IP=203.0.113.10
LK_SERVER_URL=
LIVEKIT_NODE_IP=

# Optional LiveKit API address for FastAPI.
# Compose defaults to http://livekit:7880 in local mode
# and http://127.0.0.1:7880 in VPS mode.
LK_API_URL=

# Only for running FastAPI by hand. Compose sets /data/chat.db itself.
# DB_NAME=chat.db
# Default room for the API when the client does not pass one.
# VOICE_ROOM_NAME=Voice-Lounge

# Media storage (S3, Timeweb Cloud). Keys are in the bucket panel.
# S3_ENDPOINT=https://s3.twcstorage.ru
# S3_BUCKET=3e88f5e3-35cc-4a02-9d3c-95cfbb3707c0
# S3_REGION=ru-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Token for admin endpoints (chat cleanup). Empty disables them.
ADMIN_TOKEN=
