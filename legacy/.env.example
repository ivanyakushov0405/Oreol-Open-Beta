# Обязательно для Docker Compose. Сгенерируйте оба значения по README.
LK_API_KEY=
LK_API_SECRET=

# Для запуска через интернет укажите WSS-адрес Nginx и публичный IPv4 VPS.
# Пример LK_SERVER_URL=wss://rtc.example.com
# Пример LIVEKIT_NODE_IP=203.0.113.10
LK_SERVER_URL=
LIVEKIT_NODE_IP=

# Необязательный адрес LiveKit API для FastAPI.
# Compose по умолчанию использует http://livekit:7880 в локальном режиме
# и http://127.0.0.1:7880 в режиме VPS.
LK_API_URL=

# Только для ручного запуска FastAPI. Compose сам задаёт /data/chat.db.
# DB_NAME=chat.db
# Комната по умолчанию для API, когда клиент не передал её имя.
# VOICE_ROOM_NAME=Voice-Lounge
